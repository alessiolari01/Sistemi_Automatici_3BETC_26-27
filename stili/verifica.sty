  \begin{center}\small\gradetable[h][questions]\end{center}}

% Lineare a tratti: 0 pt -> voto minimo, soglia% -> 6, punteggio pieno -> 10.
\newcommand{\v@num}[1]{\num[drop-zero-decimal]{#1}}
\newcommand{\grigliavoto}{%
  \@ifundefined{exam@numpoints}%
    {\par\noindent\textit{(Griglia voti: compila due volte.)}\par}%
    {\begingroup
     \def\v@rigaV{\textbf{Voto}}\def\v@rigaP{\textbf{Punti} $\geq$}%
     \ifdefempty{\v@pmax}{\pgfmathsetmacro\v@max{\exam@numpoints}}{\pgfmathsetmacro\v@max{\v@pmax}}%
     \pgfmathsetmacro\v@s{\v@soglia/100}%
     \foreach \v in {\v@votomin,...,10}{%
       \pgfmathsetmacro\v@p{\v<=6 ? \v@s*\v@max*(\v-\v@votomin)/(6-\v@votomin)
                                 : \v@max*(\v@s+(1-\v@s)*(\v-6)/4)}%
       \pgfmathsetmacro\v@p{round(2*\v@p)/2}%
       \ifnum\v=6
         \xappto\v@rigaV{& \noexpand\textbf{\v}}%
         \xappto\v@rigaP{& \noexpand\textbf{\noexpand\v@num{\v@p}}}%
       \else
         \xappto\v@rigaV{& \v}\xappto\v@rigaP{& \noexpand\v@num{\v@p}}%
       \fi}%
     \pgfmathtruncatemacro\v@n{11-\v@votomin}%
     \begin{center}\small
       \renewcommand{\arraystretch}{1.3}%
       \begin{tabular}{|l|*{\v@n}{c|}}\hline
         \v@rigaV\\\hline \v@rigaP\\\hline
       \end{tabular}\\[3pt]
       {\footnotesize Sufficienza (6) al \v@soglia\,\% del
        punteggio massimo (\v@num{\v@max}\ pt).}
     \end{center}
     \endgroup}}

% \riepilogo: tabella punti + griglia voti in fondo alla 2ª pagina
% (fronte/retro = un solo foglio). Se la verifica supera le 2 pagine
% finisce in fondo all'ultima e nel log compare VERIFICA-PAGINE.
\newcommand{\riepilogo}{%
  \ifv@corr \v@riepilogocorr
  \else\ifv@sol
  \else\ifv@casa
  \else \v@riepilogo\fi\fi\fi}
% griglia di correzione: blocchi degli esercizi + griglia voti
\newcommand{\v@riepilogocorr}{%
  \par\ifvoid\v@grigliabox\else\unvbox\v@grigliabox\par\fi
  \ifnum\value{v@tondi}>0
    \noindent{\small\textbf{[!]} = risultato troppo ``tondo''
      (\arabic{v@tondi} trovati).}\par\fi
  \ifv@casa\else\vspace{6pt}\noindent\begin{minipage}{\textwidth}
    \grigliavoto\end{minipage}\fi}
\newcommand{\v@riepilogo}{%
  \par
  \ifnum\value{page}<2 \newpage\fi
  \vspace*{\fill}%
  \noindent\begin{minipage}{\textwidth}
    \tabellapunteggi
    \vspace{-4pt}
    \grigliavoto
  \end{minipage}%
  \ifnum\value{page}>2 \ifv@completa\else
    \PackageWarningNoLine{verifica}{VERIFICA-PAGINE: la prova occupa
      \thepage\space pagine, non sta in un foglio fronte/retro}\fi
  \fi
  \ifv@completa\newpage\tabellacontrollo\fi}

\endinput
