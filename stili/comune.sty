}

% \morsetti{G}: segni + e - accanto a un generatore disegnato con
%   to[vsource, l=$V$, n=G] (fine)
% Il + va verso la fine del tratto (il punto dopo "to"), il - verso l'inizio.
% Opzionale la distanza: \morsetti[0.4cm]{G}
\newcommand{\morsetti}[2][0.32cm]{%
  \path ($(#2.center)!1.25!(#2.right)$) coordinate (mors@p)
        ($(#2.center)!1.25!(#2.left)$)  coordinate (mors@m);
  \node[inner sep=0pt,font=\normalsize] at ($(mors@p)!#1!90:(#2.right)$) {$+$};
  \node[inner sep=0pt,font=\normalsize] at ($(mors@m)!#1!-90:(#2.left)$) {$-$};}

% ---------- Circuiti: resistori a rettangolo, correnti sul ramo ---------
% Da usare dentro \begin{circuitikz}[x=1cm,y=1cm] (coordinate in cm).
%  \resV{x}{y1}{y2}{R_1}   resistore verticale: filo + rettangolo col nome dentro
%  \resH{x1}{x2}{y}{R_2}   resistore orizzontale
%  \corV{x}{y}{d|u}{I_1}   freccia della corrente SUL filo (verticale, giù/su)
%  \corH{x}{y}{r|l}{I}     freccia della corrente SUL filo (orizzontale)
%  \nodo{x}{y}{A}{above left}   punto + lettera del nodo (posizione della lettera)
%  \etich{x}{y}{A}{above}       solo la lettera (se il punto c'è già)
%  \segniV{x}{y}{V_5}      segni + e - e nome della tensione, a destra di un
%                          resistore verticale centrato in (x,y)
\newcommand{\resV}[4]{%
  \draw (#1,#2) -- (#1,#3);
  \node[draw,fill=white,minimum width=6mm,minimum height=10.5mm,inner sep=0pt]
    at ({#1},{(#2+#3)/2}) {\small $#4$};}
\newcommand{\resH}[4]{%
  \draw (#1,#3) -- (#2,#3);
  \node[draw,fill=white,minimum width=10.5mm,minimum height=5.5mm,inner sep=0pt]
    at ({(#1+#2)/2},{#3}) {\small $#4$};}
\newcommand{\corV}[4]{%
  \ifstrequal{#3}{d}%
    {\draw[thick,-{Stealth[length=2.2mm]}] ({#1},{#2+0.3}) -- ({#1},{#2-0.3});}%
    {\draw[thick,-{Stealth[length=2.2mm]}] ({#1},{#2-0.3}) -- ({#1},{#2+0.3});}%
  \node[anchor=west,inner sep=2pt] at ({#1+0.04},{#2}) {\small $#4$};}
\newcommand{\corH}[4]{%
  \ifstrequal{#3}{r}%
    {\draw[thick,-{Stealth[length=2.2mm]}] ({#1-0.3},{#2}) -- ({#1+0.3},{#2});}%
    {\draw[thick,-{Stealth[length=2.2mm]}] ({#1+0.3},{#2}) -- ({#1-0.3},{#2});}%
  \node[anchor=south,inner sep=2pt] at ({#1},{#2+0.04}) {\small $#4$};}
\newcommand{\nodo}[4]{%
  \node[circ] at (#1,#2) {}; \node[#4,inner sep=1.5pt] at (#1,#2) {\small #3};}
\newcommand{\etich}[4]{\node[#4,inner sep=1.5pt] at (#1,#2) {\small #3};}
% resistore orizzontale centrato in (x,y): segni e nome sotto il filo (#4 = l: + a sinistra, r: + a destra)
\newcommand{\segniH}[4]{%
  \ifstrequal{#4}{l}{\def\sg@a{+}\def\sg@b{-}}{\def\sg@a{-}\def\sg@b{+}}%
  \node[inner sep=0pt] at ({#1-0.6},{#2-0.65}) {\small $\sg@a$};
  \node[inner sep=0pt] at ({#1+0.6},{#2-0.65}) {\small $\sg@b$};
  \node[inner sep=0pt] at ({#1},{#2-0.65}) {\small $#3$};}
\newcommand{\segniV}[3]{%
  \node[inner sep=0pt] at ({#1+0.62},{#2+0.45}) {\small $+$};
  \node[inner sep=0pt] at ({#1+0.62},{#2-0.45}) {\small $-$};
  \node[anchor=west,inner sep=1pt] at ({#1+0.8},{#2}) {\small $#3$};}

% ---------- Diagrammi di flusso -----------------------------------------
% Dentro \begin{tikzpicture}[x=1cm,y=1cm]:
%   \node[fcterm] (i) at (0,0) {Inizio};        inizio / fine (ovale)
%   \node[fcio]   (l) at (0,-1) {Leggi $N$};    input / output (parallelogramma)
%   \node[fcproc] (p) at (0,-2) {$S \gets 0$};  elaborazione (rettangolo)
%   \node[fcdec]  (d) at (0,-3) {$N>0$?};       decisione (rombo)
%   \draw[fcfreccia] (i) -- (l);                freccia di collegamento
%   \node[fcsi] at (...) {Sì};  \node[fcno] at (...) {No};  etichette dei rami
\tikzset{
  fcbase/.style  = {draw, thick, align=center, font=\small, inner sep=3pt,
                    minimum height=7.5mm, fill=white},
  fcterm/.style  = {fcbase, rounded corners=3.75mm, minimum width=19mm},
  fcio/.style    = {fcbase, trapezium, trapezium left angle=72,
                    trapezium right angle=108, trapezium stretches body,
                    minimum width=24mm},
  fcproc/.style  = {fcbase, rectangle, minimum width=22mm},
  fcdec/.style   = {fcbase, diamond, aspect=2.2, inner sep=1pt},
  fcfreccia/.style = {thick, -{Stealth[length=2.2mm]}},
  fcsi/.style    = {font=\footnotesize, inner sep=1.5pt},
  fcno/.style    = {font=\footnotesize, inner sep=1.5pt},
}

